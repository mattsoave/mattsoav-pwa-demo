{
  "name": "PWA demo",
  "short_name": "PWA demo",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#12151a",
  "theme_color": "#1f6feb",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "file", "accept": ["text/csv", "text/comma-separated-values", "application/csv", "application/vnd.ms-excel", "text/plain", ".csv"] }
      ]
    }
  }
}
